PORT=5000
NODE_ENV=development

# Browser origin for CORS only — NOT your MongoDB URL.
# CORS_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/order_management

# JWT auth (required)
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Firebase Auth — must match Firebase Console project (same as VITE_FIREBASE_PROJECT_ID on the frontend)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Admin emails for Firebase / JWT (comma-separated). Default includes product admin if unset.
# ADMIN_EMAILS=demo@inventory.app,mahirmubtasimsiyam@gamil.com
# Or mark only the demo account as admin (match VITE_DEMO_EMAIL on the frontend):
# DEMO_AS_ADMIN=true
# DEMO_EMAIL=demo@inventory.app
