# Auth hero: login uses URL 1, signup uses URL 2 (full URL or /file-in-public.jpg).
# VITE_AUTH_HERO_IMAGE_URL=
# VITE_AUTH_HERO_IMAGE_URL_2=

# Data layer: leave remote API off to use browser localStorage only.
# VITE_USE_REMOTE_API=true
# VITE_API_BASE_URL=http://localhost:5000/api

# Legacy default admin demo email (used by “Demo login as Admin” unless overridden)
VITE_DEMO_EMAIL=demo@inventory.app
VITE_DEMO_PASSWORD=DemoPass123!

# “Demo login as User” — portal role (not in backend ADMIN_EMAILS / DEMO_AS_ADMIN)
VITE_DEMO_USER_EMAIL=portal@inventory.app
# VITE_DEMO_USER_PASSWORD=DemoPass123!

# “Demo login as Admin” — staff (defaults to VITE_DEMO_EMAIL above)
# VITE_DEMO_ADMIN_EMAIL=demo@inventory.app
# VITE_DEMO_ADMIN_PASSWORD=DemoPass123!
# Set true so the demo email is treated as admin (must mirror backend DEMO_AS_ADMIN + DEMO_EMAIL)
# VITE_DEMO_AS_ADMIN=true

# Legacy default (local mock + Vite proxy if configured)
VITE_API_BASE_URL=/api

# —— Firebase (Email/Password + Google) — set all web app keys from Firebase Console
# Enable Google: Authentication → Sign-in method → Google. Add localhost to Authorized domains for dev.
# Backend also needs FIREBASE_SERVICE_ACCOUNT_PATH (or _JSON). Set false to use only /auth/login.
# VITE_USE_FIREBASE_AUTH=true
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Comma-separated admin emails (optional; defaults to product admin). You can list demo here instead of VITE_DEMO_AS_ADMIN.
# VITE_ADMIN_EMAILS=demo@inventory.app,mahirmubtasimsiyam@gamil.com
